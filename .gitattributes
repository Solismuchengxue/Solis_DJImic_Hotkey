* text=auto
/.gitattributes text eol=lf
/.gitignore text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.json text eol=lf

# Preserve BOM, CRLF and manifest hashes in clones and source archives.
*.ahk -text
*.ini -text

# Keep upstream whitespace intact; added license comments are checked separately.
/localization/UX/*.ahk whitespace=-blank-at-eol,cr-at-eol
