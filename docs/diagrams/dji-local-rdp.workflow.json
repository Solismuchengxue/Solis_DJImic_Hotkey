  "cards": [
    {
      "dot": "cyan",
      "title": "先点进真正的聊天输入框",
      "items": [
        "AHK 只运行在接收器所在本机；远端不运行此脚本。",
        "发送前仍须启用且前台 HWND 未变；失焦便放弃。",
        "按一次开始、再按一次结束，检查转写后手动发送。"
      ]
    },
    {
      "dot": "emerald",
      "title": "声音与按钮走不同通道",
      "items": [
        "Wireless Mic Rx → 本机 ChatGPT；远端通过 RDP 录音重定向。",
        "AHK 选择并发送快捷键，录音与转写由 ChatGPT 完成。"
      ]
    },
    {
      "dot": "amber",
      "title": "设备识别与音量取舍",
      "items": [
        "DJI：VID 2CA3 / PID 4011 / MI_00 / Col01；按下边沿，默认去抖 250ms。",
        "设备识别只决定谁能触发听写；音量保护会连键盘音量加一起拦截。",
        "仓库示例开关为 0，原部署文档记录为 1；本图未重新执行实机测试。"
      ]
    }
  ]
